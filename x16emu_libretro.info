firmware0_opt = "false"

notes = "(!) x16/rom.bin: the KERNAL ROM from an x16emu release (github.com/X16Community/x16-emulator/releases), put in the system directory.|(!) .img: SD card image, the KERNAL runs AUTOBOOT.X16 from it.|(!) .prg / .bas: loaded and run at startup and after every reset; files next to the content are reachable as device 8.|(!) The RTC NVRAM (KERNAL settings) is kept as the save RAM (.srm).|(!) Use Game Focus (Scroll Lock) to type on the X16 keyboard."

description = "Commander X16 emulator (x16emu). Emulates the 65C02 (or 65C816), VERA video and PCM/PSG audio, the YM2151, the SD card and the SNES controller ports of The 8-Bit Guy's Commander X16."
